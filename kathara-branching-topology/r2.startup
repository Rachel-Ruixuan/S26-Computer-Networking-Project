ip addr add 10.0.12.2/24 dev eth0
ip addr add 10.0.23.1/24 dev eth1
ip addr add 10.0.24.1/24 dev eth2

ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

sysctl -w net.ipv4.ip_forward=1

ip route add 10.0.1.0/24 via 10.0.12.1
ip route add 10.0.3.0/24 via 10.0.23.2
ip route add 10.0.4.0/24 via 10.0.24.2